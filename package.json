{
  "name": "multi-agent-desktop",
  "version": "1.0.0",
  "private": true,
  "main": ".electron/main.js",
  "author": "Multi-agent Team",
  "description": "Multi-agent enterprise desktop AI workspace",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "verify": "pnpm lint && pnpm typecheck && pnpm electron:typecheck",
    "electron:dev": "pnpm electron:compile && electron .",
    "electron:compile": "pnpm electron:typecheck && tsx scripts/compile-electron.ts",
    "electron:typecheck": "tsc --project electron/tsconfig.json --noEmit",
    "electron:prepare": "tsx scripts/build-electron.ts",
    "electron:prepare-icons": "tsx scripts/prepare-electron-icons.ts",
    "release:clean": "tsx scripts/clean-release.ts",
    "electron:pack": "pnpm release:clean && pnpm electron:prepare && pnpm electron:prepare-icons && pnpm exec electron-builder --dir --config electron-builder.yml",
    "electron:build": "pnpm electron:pack",
    "electron:package": "pnpm electron:pack",
    "electron:make": "pnpm release:clean && pnpm electron:prepare && pnpm electron:prepare-icons && pnpm exec electron-builder --config electron-builder.yml",
    "electron:make:win": "pnpm release:clean && pnpm electron:prepare && pnpm electron:prepare-icons && pnpm exec electron-builder --win --x64 --config electron-builder.yml",
    "electron:make:mac": "pnpm release:clean && pnpm electron:prepare && pnpm electron:prepare-icons && pnpm exec electron-builder --mac --config electron-builder.yml",
    "electron:make:linux": "pnpm release:clean && pnpm electron:prepare && pnpm electron:prepare-icons && pnpm exec electron-builder --linux --x64 --config electron-builder.yml",
    "test:electron-port": "tsx scripts/test-electron-port-selection.ts",
    "test:agent-runtime": "tsx scripts/test-agent-production-features.ts",
    "test:commerce-routing": "tsx scripts/test-amazon-data-source.ts && tsx scripts/test-platform-data-sources.ts",
    "test:amazon-crawler": "tsx scripts/test-amazon-crawler-network.ts",
    "test:platform-routing": "tsx scripts/test-platform-data-sources.ts",
    "test:platform-data-sources": "tsx scripts/test-platform-data-sources.ts",
    "test:platform-crawlers": "tsx scripts/test-platform-crawlers-network.ts",
    "crawler:install-browser": "pnpm dlx playwright@1.61.1 install chromium",
    "crawler:install-browser:deps": "pnpm dlx playwright@1.61.1 install --with-deps chromium",
    "test:platform-crawlers:strict": "cross-env COMMERCE_CRAWLER_NETWORK_TEST_STRICT=true tsx scripts/test-platform-crawlers-network.ts",
    "test:context-memory": "tsx scripts/test-context-memory.ts",
    "test:memory-reflection": "tsx scripts/test-memory-reflection.ts",
    "test:amazon-listing-demo": "tsx scripts/test-amazon-listing-demo.ts",
    "test:commerce-planning": "tsx scripts/test-commerce-planning-sync.ts"
  },
  "dependencies": {
    "@google/genai": "^2.6.0",
    "@langchain/core": "^1.1.49",
    "@langchain/langgraph": "^1.4.2",
    "@sentry/nextjs": "^10.58.0",
    "electron-updater": "^6.8.9",
    "https-proxy-agent": "^9.0.0",
    "next": "16.2.6",
    "node-fetch": "^2.7.0",
    "pdfjs-dist": "^5.7.284",
    "playwright-core": "^1.61.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "react-textarea-autosize": "^8.5.9",
    "react-virtuoso": "^4.18.7",
    "remark-gfm": "^4.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.19",
    "@types/lodash": "^4.17.24",
    "@types/node": "^25.9.1",
    "@types/node-fetch": "^2.6.13",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "cross-env": "^10.1.0",
    "electron": "^43.0.0",
    "electron-builder": "^25.1.8",
    "electron-is-dev": "^3.0.1",
    "electron-squirrel-startup": "^1.0.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "lodash": "^4.18.1",
    "png-to-ico": "^3.0.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@10.12.1"
}
