# ============================================================
# LLM provider keys
# ============================================================
DASHSCOPE_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
GLM_API_KEY=
KIMI_API_KEY=

# ============================================================
# Cross-border Market Intelligence / Commerce Agent
# ============================================================

# TalorData SERP API. This is the v9 core market-intelligence data source.
TALORDATA_API_TOKEN=
# Backward-compatible alias for v5-v7 builds. If both exist, TALORDATA_API_TOKEN wins.
SERPAPI_API_KEY=
# Optional endpoint override. Leave empty to let the client try the supported TalorData SERP endpoints automatically.
TALORDATA_SERP_ENDPOINT=

# Optional Keepa Amazon history / Sales Rank enhancement. It is NOT required for v9 report completion.
KEEPA_API_KEY=

# TikTok developer / TikTok Shop partner credentials.
# Without Merchant ID, the health check only validates client credentials.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_MERCHANT_ID=

# Temu Open Platform. The default endpoint targets the US Open Platform router.
TEMU_APP_KEY=
TEMU_APP_SECRET=
TEMU_ACCESS_TOKEN=
TEMU_API_ENDPOINT=https://openapi-b-us.temu.com/openapi/router

# Alibaba / 1688 Open Platform (TOP protocol).
ALIBABA_1688_APP_KEY=
ALIBABA_1688_APP_SECRET=
ALIBABA_1688_ACCESS_TOKEN=
ALIBABA_1688_API_ENDPOINT=https://eco.taobao.com/router/rest

# Optional Seller SP-API enhancement; NOT required for public market research.
AMAZON_SP_API_CLIENT_ID=
AMAZON_SP_API_CLIENT_SECRET=
AMAZON_SP_API_REFRESH_TOKEN=
AMAZON_SP_API_ACCESS_TOKEN=

# Amazon 公开页面爬虫。默认开启：当 Amazon API 未配置、失败或返回空数据时自动接管。
# 只有明确不允许公开页面采集时才设置为 false。
AMAZON_PUBLIC_RESEARCH_ENABLED=true

# 可选：Amazon 爬虫专用代理。未填写时依次读取 HTTPS_PROXY / HTTP_PROXY。
# Electron、公司网络或受限网络环境中建议配置；不要把含账号密码的代理地址提交到 Git。
AMAZON_CRAWLER_PROXY_URL=
HTTPS_PROXY=
HTTP_PROXY=
NO_PROXY=localhost,127.0.0.1

# 可选爬虫参数。默认值已兼顾演示速度与访问频率，一般无需修改。
AMAZON_CRAWLER_MAX_KEYWORDS=3
AMAZON_CRAWLER_MAX_PAGES_PER_KEYWORD=2
AMAZON_CRAWLER_MAX_DETAIL_PRODUCTS=10
AMAZON_CRAWLER_DETAIL_CONCURRENCY=2
AMAZON_CRAWLER_REQUEST_INTERVAL_MS=1200
AMAZON_CRAWLER_TIMEOUT_MS=18000
AMAZON_CRAWLER_CACHE_TTL_MS=600000
AMAZON_CRAWLER_USER_AGENT=
