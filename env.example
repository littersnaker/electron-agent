# ============================================================
# LLM provider keys
# ============================================================
DASHSCOPE_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
GLM_API_KEY=
KIMI_API_KEY=

# ============================================================
# Electron local server
# ============================================================
# Electron 只把该值当作“端口扫描起点”，不会固定占用它。
# 例如设置为 4000 后，会依次检测 4000、4001、4002……直到找到可用端口。
ELECTRON_PORT_SCAN_START=3000

# ============================================================
# Cross-border Market Intelligence / Commerce Agent
# ============================================================

# TalorData SERP API. This is the v9 core market-intelligence data source.
TALORDATA_API_TOKEN=
# Backward-compatible alias for v5-v7 builds. If both exist, TALORDATA_API_TOKEN wins.
SERPAPI_API_KEY=
# Optional endpoint override. Leave empty to let the client try the supported TalorData SERP endpoints automatically.
TALORDATA_SERP_ENDPOINT=

# Optional Keepa Amazon history / Sales Rank enhancement. It is NOT required for v9 report completion.
KEEPA_API_KEY=

# TikTok developer / TikTok Shop partner credentials.
# Without Merchant ID, the health check only validates client credentials.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_MERCHANT_ID=

# Temu Open Platform. The default endpoint targets the US Open Platform router.
TEMU_APP_KEY=
TEMU_APP_SECRET=
TEMU_ACCESS_TOKEN=
TEMU_API_ENDPOINT=https://openapi-b-us.temu.com/openapi/router

# Alibaba / 1688 Open Platform (TOP protocol).
ALIBABA_1688_APP_KEY=
ALIBABA_1688_APP_SECRET=
ALIBABA_1688_ACCESS_TOKEN=
ALIBABA_1688_API_ENDPOINT=https://eco.taobao.com/router/rest

# Optional Seller SP-API enhancement; NOT required for public market research.
AMAZON_SP_API_CLIENT_ID=
AMAZON_SP_API_CLIENT_SECRET=
AMAZON_SP_API_REFRESH_TOKEN=
AMAZON_SP_API_ACCESS_TOKEN=

# Amazon 公开页面爬虫。默认开启：当 Amazon API 未配置、失败或返回空数据时自动接管。
# 只有明确不允许公开页面采集时才设置为 false。
AMAZON_PUBLIC_RESEARCH_ENABLED=true

# 可选：Amazon 爬虫专用代理。未填写时依次读取 HTTPS_PROXY / HTTP_PROXY。
# Electron、公司网络或受限网络环境中建议配置；不要把含账号密码的代理地址提交到 Git。
AMAZON_CRAWLER_PROXY_URL=
HTTPS_PROXY=
HTTP_PROXY=
NO_PROXY=localhost,127.0.0.1

# 可选爬虫参数。默认值已兼顾演示速度与访问频率，一般无需修改。
AMAZON_CRAWLER_MAX_KEYWORDS=3
AMAZON_CRAWLER_MAX_PAGES_PER_KEYWORD=2
AMAZON_CRAWLER_MAX_DETAIL_PRODUCTS=10
AMAZON_CRAWLER_DETAIL_CONCURRENCY=2
AMAZON_CRAWLER_REQUEST_INTERVAL_MS=1200
AMAZON_CRAWLER_TIMEOUT_MS=18000
AMAZON_CRAWLER_CACHE_TTL_MS=600000
AMAZON_CRAWLER_USER_AGENT=

# ============================================================
# TikTok Shop / Temu / 1688 公开页面爬虫
# ============================================================
# 三个平台默认开启。对应 API 未配置、请求失败或返回空数据时，Auto Provider 会自动切换爬虫。
TIKTOK_SHOP_PUBLIC_RESEARCH_ENABLED=true
TEMU_PUBLIC_RESEARCH_ENABLED=true
ALIBABA_1688_PUBLIC_RESEARCH_ENABLED=true

# 通用跨平台爬虫代理。平台专用代理优先级更高；均为空时回退 HTTPS_PROXY / HTTP_PROXY。
COMMERCE_CRAWLER_PROXY_URL=
TIKTOK_SHOP_CRAWLER_PROXY_URL=
TEMU_CRAWLER_PROXY_URL=
ALIBABA_1688_CRAWLER_PROXY_URL=

# 可选：覆盖公开搜索页地址。{keyword} 与 {page} 会在运行时自动替换。
TIKTOK_SHOP_CRAWLER_SEARCH_URL_TEMPLATE=https://shop.tiktok.com/us/search?q={keyword}&page={page}
TEMU_CRAWLER_SEARCH_URL_TEMPLATE=https://www.temu.com/search_result.html?search_key={keyword}&page={page}
ALIBABA_1688_CRAWLER_SEARCH_URL_TEMPLATE=https://s.1688.com/selloffer/offer_search.htm?keywords={keyword}&beginPage={page}

# 通用频率、超时与缓存参数。所有平台共享请求队列，防止并发瞬间打满目标站点。
COMMERCE_CRAWLER_MAX_KEYWORDS=2
COMMERCE_CRAWLER_MAX_PAGES_PER_KEYWORD=2
COMMERCE_CRAWLER_REQUEST_INTERVAL_MS=1500
COMMERCE_CRAWLER_TIMEOUT_MS=20000
COMMERCE_CRAWLER_CACHE_TTL_MS=600000
COMMERCE_CRAWLER_USER_AGENT=
TIKTOK_SHOP_CRAWLER_USER_AGENT=
TEMU_CRAWLER_USER_AGENT=
ALIBABA_1688_CRAWLER_USER_AGENT=

# ============================================================
# Playwright 浏览器爬虫（TikTok Shop / Temu / 1688 第二级回退）
# ============================================================
# API 不可用时先尝试 HTTP 公开页；HTTP 失败或只返回 JavaScript 壳时再启动浏览器。
COMMERCE_BROWSER_CRAWLER_ENABLED=true
COMMERCE_BROWSER_HEADLESS=true
COMMERCE_BROWSER_CONCURRENCY=1
COMMERCE_BROWSER_LAUNCH_TIMEOUT_MS=30000
COMMERCE_BROWSER_NAVIGATION_TIMEOUT_MS=30000
COMMERCE_BROWSER_SETTLE_MS=2500
COMMERCE_BROWSER_SCROLL_STEPS=3
COMMERCE_BROWSER_MAX_PAGES_PER_KEYWORD=2
COMMERCE_BROWSER_MAX_JSON_RESPONSES=100
COMMERCE_BROWSER_MAX_JSON_BYTES=5242880

# 可选：指定本机 Chrome / Edge / Chromium。通常 Windows 可直接使用 chrome 或 msedge。
COMMERCE_BROWSER_CHANNEL=
COMMERCE_BROWSER_EXECUTABLE_PATH=

# 可选：每个平台可配置多个浏览器搜索地址，使用竖线 | 或换行分隔。
TIKTOK_SHOP_BROWSER_SEARCH_URL_TEMPLATES=https://www.tiktok.com/shop/search?q={keyword}|https://shop.tiktok.com/us/search?q={keyword}&page={page}
TEMU_BROWSER_SEARCH_URL_TEMPLATES=https://www.temu.com/search_result.html?search_key={keyword}&page={page}
ALIBABA_1688_BROWSER_SEARCH_URL_TEMPLATES=https://s.1688.com/selloffer/offer_search.htm?keywords={keyword}&beginPage={page}

# 网络冒烟测试默认只输出诊断；设为 true 后要求至少一个平台真实取得样本。
COMMERCE_CRAWLER_NETWORK_TEST_STRICT=false

# ============================================================
# Agent 生产能力：Trace / Context Cache / MCP
# ============================================================
# Trace、工具事件与在线评估的 SQLite 数据目录。默认使用项目根目录 .agent-data。
AGENT_DATA_DIR=

# Search/File Context 的进程内有界缓存。写文件成功后会按项目自动失效。
AGENT_CONTEXT_CACHE_TTL_MS=300000
AGENT_CONTEXT_CACHE_MAX_ENTRIES=128
AGENT_CONTEXT_CACHE_MAX_VALUE_CHARS=16000

# MCP Streamable HTTP 服务配置。建议优先使用项目根目录 .agent-mcp.json。
# JSON 可参考 .agent-mcp.example.json；敏感 Header 使用 ${ENV_NAME} 引用环境变量。
MCP_SERVERS_JSON=
MCP_REQUEST_TIMEOUT_MS=15000
MCP_CATALOG_TTL_MS=60000
LOCAL_MCP_TOKEN=

# Trace 数据保留策略，防止 SQLite 长期运行后无限增长。
AGENT_TRACE_RETENTION_DAYS=30
AGENT_TRACE_MAX_RUNS=5000
AGENT_TRACE_MAX_EVENTS_PER_RUN=2000

# ============================================================
# Agent 上下文预算与记忆排序
# ============================================================
# 单次 LLM 调用的总上下文窗口。预算管理器会预留输出与安全空间后再裁剪输入。
AGENT_CONTEXT_WINDOW_TOKENS=32000
# 可选：统一覆盖不同任务默认的输出预留 Token。
AGENT_CONTEXT_OUTPUT_RESERVE_TOKENS=
# 防止估算误差导致 Provider 拒绝请求的安全余量。
AGENT_CONTEXT_SAFETY_MARGIN_TOKENS=800
# 被保留消息的最小预算，避免裁剪后只剩空壳。
AGENT_CONTEXT_MIN_MESSAGE_TOKENS=96

# Reflection Agent 可单独指定模型；留空时继续使用自动模型路由。
LLM_ROUTE_REFLECTION=
