# ============================================================================
# Multi-agent Electron + React + FastAPI 环境变量示例
# 复制本文件为 .env.local，再填入你真正需要的密钥。
# 不要把 .env.local 提交到 Git，也不要把密钥硬编码进前端代码。
# ============================================================================

# ------------------------------ LLM 模型 ------------------------------------
# 打包 Python 后端时会把此值作为百炼共享兜底嵌入可执行文件。
# 用户在应用内填写自己的 Key 后，会优先使用用户 Key。
DASHSCOPE_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
GLM_API_KEY=
KIMI_API_KEY=
# 豆包 / 火山引擎方舟：配置后可用于媒体 Agent 的豆包文生图/文生视频模型。
DOUBAO_API_KEY=
DOUBAO_BASE_URL=

# 媒体 Agent 实际使用的模型（可改成豆包模型 ID，需先填上面的 Key）：
# MEDIA_IMAGE_MODEL=doubao:doubao-seedream-3-0-t2i
# MEDIA_VIDEO_MODEL=doubao:doubao-seedance-1-0-t2v

# 可选：百炼 OpenAI-compatible Base URL。一般不需要修改。
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 可选：百炼图片/视频原生接口根域名。优先使用新变量；旧变量继续兼容。
DASHSCOPE_MEDIA_BASE_URL=https://dashscope.aliyuncs.com
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com

# 可选：指定构建时读取的环境文件；默认读取项目根目录 .env.local。
BUILTIN_CREDENTIALS_ENV_FILE=
# 设为 1 后，如果构建时没有百炼 Key 会立即失败，防止误发无兜底安装包。
REQUIRE_BUILTIN_QWEN_KEY=0

# --------------------------- FastAPI 本地服务 -------------------------------
# Electron 会自动寻找可用端口；单独运行后端时使用下面的 host 和 port。
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8765
LOG_LEVEL=INFO
REQUEST_TIMEOUT_SECONDS=120
MAX_UPLOAD_MEGABYTES=40

# --------------------------- 请求审计日志 -----------------------------------
# 按 requestId 记录 HTTP 与 LLM 请求（Agent 身份、请求参数、响应结果），
# 输出为项目根目录 request-audit-YYYYMMDD.jsonl，已加入 .gitignore 不会上传。
# 排查命令：python -m backend.core.request_audit query --request-id <id>
REQUEST_AUDIT_ENABLED=1
# REQUEST_AUDIT_DIR=
REQUEST_AUDIT_MAX_FILE_MB=100
REQUEST_AUDIT_MAX_PAYLOAD_CHARS=30000
REQUEST_AUDIT_MAX_MESSAGE_CHARS=8000
REQUEST_AUDIT_MAX_BODY_CHARS=100000

# 留空时开发数据保存在项目根目录 .local-data。
# Electron 运行时会自动改为系统用户数据目录，不需要手动填写。
AGENT_DATA_DIR=

# 仅在单独运行 Vite、没有经过 Electron preload 时使用。
VITE_BACKEND_URL=http://127.0.0.1:8765

# Electron 开发模式端口扫描起点。
ELECTRON_PORT_SCAN_START=8765
# 设置为 1 时自动打开 Electron DevTools。
ELECTRON_OPEN_DEVTOOLS=0
# 可选：明确指定开发模式 Python 解释器。
PYTHON_EXECUTABLE=

# ------------------------- Code Agent 并行调度 ------------------------------
# 同时运行的独立 Work 数量。它只限制并发请求数，不限制 Work 总数、文件总数或修改轮次。
# 互不依赖且 targetFiles/serialGroup 不冲突的 Work 会并行；同一文件按 priority 串行。
CODE_AGENT_PARALLEL_WORKERS=4

# 命令审批门：设为 1 后，安装/初始化/脚手架类命令（pnpm install、pnpm add、
# npx create-vite 等）会先弹窗征求用户确认，批准后才执行；默认 0 保持全拦截。
CODE_AGENT_COMMAND_APPROVAL=0

# 安装类命令审批通过后的执行超时（秒，范围 60-600，默认 600）。
CODE_AGENT_INSTALL_TIMEOUT_SECONDS=600

# 安装包白名单（逗号分隔，小写）。留空表示用户批准后允许任意包；
# 设置后只允许安装白名单内的包，其余即使批准也会被拦截。
# 示例：gsap,react,react-dom
CODE_AGENT_INSTALL_PACKAGE_WHITELIST=

# ---------------------------- 跨境电商研究 ---------------------------------
# 已配置时调用 TalorData；未配置时返回明确标记为 demo 的演示数据。
TALORDATA_API_TOKEN=
SERPAPI_API_KEY=
KEEPA_API_KEY=
# Amazon SP-API 凭据：配置后走官方 Catalog Search；留空时市场研究自动回退
# Amazon 公开搜索页爬虫（可用 COMMERCE_AMAZON_CRAWLER=0 关闭）。
AMAZON_SP_API_CLIENT_ID=
AMAZON_SP_API_CLIENT_SECRET=
AMAZON_SP_API_REFRESH_TOKEN=

# 以下凭证只用于在配置状态页显示是否已设置；当前 FastAPI 迁移版尚未实现
# TikTok Shop、Temu、1688 的真实发布或下单动作。
TIKTOK_SHOP_CLIENT_KEY=
TIKTOK_SHOP_CLIENT_SECRET=
TIKTOK_SHOP_MERCHANT_ID=
TEMU_APP_KEY=
TEMU_APP_SECRET=
TEMU_ACCESS_TOKEN=
ALIBABA_1688_APP_KEY=
ALIBABA_1688_APP_SECRET=
ALIBABA_1688_ACCESS_TOKEN=

# ------------------------------- MCP ----------------------------------------
# 推荐在项目目录创建 .agent-mcp.json；也可以在这里放 JSON 字符串。
# 敏感 Header 请写成 ${YOUR_TOKEN_NAME}，真实值再单独放到环境变量。
MCP_SERVERS_JSON=

# ------------------------------- 网络代理 -----------------------------------
# LLM/Commerce 请求可按各自客户端设置使用系统代理；媒体下载代理为了防止 SSRF，
# 不会读取这些代理变量。
HTTPS_PROXY=
HTTP_PROXY=
NO_PROXY=localhost,127.0.0.1
